# Database Configuration
POSTGRES_USER=bloguser
POSTGRES_PASSWORD=blogpassword
POSTGRES_DB=blogdb
POSTGRES_PORT=5432

# Application Configuration
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://bloguser:blogpassword@localhost:5432/blogdb

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MIN=30
